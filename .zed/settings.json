{
  "file_scan_exclusions": ["**/.direnv", "**/target"],
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": ["./Cargo.toml"],
        "cargo": { "features": "all" },
        "check": {
          "overrideCommand": ["just", "ra-check"],
          "features": "all",
          "workspace": false
        }
      }
    }
  }
}
